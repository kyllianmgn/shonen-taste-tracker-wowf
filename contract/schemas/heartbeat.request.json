{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract/heartbeat.request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentAt", "gameRunning", "appVersion"],
  "properties": {
    "sentAt": { "type": "integer", "minimum": 0 },
    "gameRunning": { "type": "boolean" },
    "appVersion": { "type": "string", "maxLength": 20 },
    "lastCharacter": { "$ref": "#/$defs/characterRef" }
  },
  "$defs": {
    "characterRef": {
      "type": "object", "additionalProperties": false,
      "required": ["region", "firstName", "surname"],
      "properties": {
        "region": { "enum": ["eu", "us", "kr", "tw"] },
        "firstName": { "type": "string", "minLength": 2, "maxLength": 12 },
        "surname": { "type": "string", "minLength": 2, "maxLength": 12 }
      }
    }
  }
}
