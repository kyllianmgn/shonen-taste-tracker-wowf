# Production stack configuration (docker-compose.yml, docs/deploy.md).
# Copy to .env next to docker-compose.yml, fill in, then `chmod 600 .env`. Never commit .env.
# Application variables are described in server/.env.example and docs/02 « Variables d'environnement ».

# --- Stack -----------------------------------------------------------------
# Published server image; leave empty locally to build server/Dockerfile.
SERVER_IMAGE=ghcr.io/<owner>/forever-tracker-server:0.1.0
# Docker network shared with Caddy (created once: docker network create caddy).
CADDY_NETWORK=caddy

# --- Database (DATABASE_URL is built from these by docker-compose.yml) -----
POSTGRES_USER=ft
POSTGRES_DB=ft
# URL-safe only (hex). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Backups ---------------------------------------------------------------
# Host folder receiving one pg_dump per day, kept BACKUP_RETENTION_DAYS days.
BACKUP_PATH=./backups
# Hour of the daily dump, UTC.
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Leave empty in production (commands are registered globally).
DISCORD_DEV_GUILD_ID=

# --- Public URL ------------------------------------------------------------
PUBLIC_BASE_URL=https://ft.mondomaine.fr

# --- Battle.net ------------------------------------------------------------
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REDIRECT_URI=https://ft.mondomaine.fr/oauth/bnet/callback
BNET_DEFAULT_REGION=eu
BNET_PUBLIC_PROFILE=false
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# --- Behaviour -------------------------------------------------------------
HEARTBEAT_INTERVAL_SEC=600
LEVEL_CAP=60
BOARD_MIN_EDIT_INTERVAL_SEC=15
APP_DOWNLOAD_URL=https://github.com/kyllianmgn/shonen-taste-tracker-wowf/releases/latest
LOG_LEVEL=info
