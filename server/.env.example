# ForeverTracker Server configuration (docs/02-spec-server.md « Variables d'environnement »).
# Copy to .env and fill in. Never commit .env. Variables marked "required" stop the server at startup
# when missing or malformed; the others fall back to the value shown.

# --- Discord ---------------------------------------------------------------
# Bot token (Developer Portal > Bot). Required, secret.
DISCORD_TOKEN=
# Application id, used to register slash commands. Required (17-20 digit snowflake).
DISCORD_CLIENT_ID=
# Dev only: register commands on this guild so changes apply instantly. Optional.
DISCORD_DEV_GUILD_ID=

# --- Database --------------------------------------------------------------
# Required. Dev value matches docker-compose.dev.yml (dev-only credentials, not a secret).
DATABASE_URL=postgresql://forever:forever@localhost:5432/forever
# e2e tests only: database wiped by `npm run test:e2e` (name must end with _test).
# TEST_DATABASE_URL=postgresql://forever:forever@localhost:5432/forever_test

# --- Public URL ------------------------------------------------------------
# Base of the API and of the OAuth callback. Required.
PUBLIC_BASE_URL=http://localhost:3000

# --- Battle.net (develop.battle.net) ----------------------------------------
# Required. BNET_CLIENT_SECRET is secret.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# Required. Must be declared identically on develop.battle.net.
BNET_REDIRECT_URI=http://localhost:3000/oauth/bnet/callback
# eu | us | kr | tw
BNET_DEFAULT_REGION=eu
# Enables reading public character profiles: true | false
BNET_PUBLIC_PROFILE=false
# AES-256-GCM key for base-mode Battle.net tokens: 32 random bytes, base64. Required, secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# --- Behaviour -------------------------------------------------------------
# Sent back to the app (seconds, >= 30).
HEARTBEAT_INTERVAL_SEC=600
# Maximum character level (>= 1).
LEVEL_CAP=60
# Board edit debounce per guild (seconds, >= 15).
BOARD_MIN_EDIT_INTERVAL_SEC=15
# Release page given by /lier appli. Required.
APP_DOWNLOAD_URL=
# fatal | error | warn | info | debug | verbose
LOG_LEVEL=info
